from qiskit.visualization import plot_bloch_multivector

qasm_str = """
OPENQASM 2.0;
include "qelib1.inc";

qreg q[8];
creg c[6];

h q[5];
h q[7];
cx q[5], q[0];
h q[0];
cx q[0], q[1];
cx q[0], q[2];
cx q[0], q[3];
cx q[0], q[4];
cx q[1], q[0];
cx q[1], q[2];
cx q[1], q[3];
cx q[1], q[4];
cx q[2], q[1];
cx q[2], q[0];
cx q[2], q[3];
cx q[2], q[4];
cx q[3], q[1];
cx q[3], q[2];
cx q[3], q[0];
cx q[3], q[4];
cx q[4], q[1];
cx q[4], q[2];
rx(pi) q[1];
cx q[4], q[3];
rx(pi) q[2];
cx q[4], q[0];
rx(pi) q[3];
ry(pi) q[3];
rz(pi) q[3];
cx q[2], q[6];
cx q[3], q[6];
cx q[4], q[6];
h q[6];
cswap q[7], q[5], q[6];
h q[7];
"""

circuit = QuantumCircuit.from_qasm_str(qasm_str)

state = Statevector.from_instruction(circuit)

plot_bloch_multivector(state) # Shows the final state on the Bloch sphere
